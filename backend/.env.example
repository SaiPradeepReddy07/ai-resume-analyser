# ==============================================================================
# Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Application Settings
PROJECT_NAME="AI Resume Analyzer API"
VERSION="1.0.0"
DEBUG=True

# Database Configuration
# Default: Local SQLite (Zero setup required for local development and testing)
DATABASE_URL="sqlite:///./resume_analyzer.db"

# For PostgreSQL (Uncomment and configure when running with PostgreSQL):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resume_analyzer"

# Security & JWT Authentication
# IMPORTANT: Generate a secure secret in production using:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY="insecure-dev-secret-change-this-in-production-resume-analyzer-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (Cross-Origin Resource Sharing)
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# File Upload Constraints
MAX_FILE_SIZE_MB=5
ALLOWED_EXTENSIONS=".pdf"
